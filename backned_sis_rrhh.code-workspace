{
  "folders": [
    {
      "name": "backend (Maven / tests)",
      "path": "backend"
    },
    {
      "name": "monorepo",
      "path": "."
    }
  ],
  "settings": {
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-21",
        "path": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home",
