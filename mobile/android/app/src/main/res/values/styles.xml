<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Pre-Flutter: fondo navy + logo grande (API < 31) -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+: solo navy (sin icono chico del sistema) -->
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
